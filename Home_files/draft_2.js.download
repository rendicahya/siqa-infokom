    dok_detail = function(id){     
        if (!id) return;
        $('.block-form').hide();
        $('.block-info').show();        
        $('.btn-buka-rubrik-detail').attr('href', appBaseUrl + '/penugasan/penilaian_mandiri/' + id);
        if (!(window.draftRowAkses && window.draftRowAkses[id] && window.draftRowAkses[id].audit)) {
            $('.btn-buka-audit-detail').hide();
        } else {
            $('.btn-buka-audit-detail').attr('href', appBaseUrl + '/penugasan/audit_rubrik/' + id).show();
        }
        var url = appBaseUrl + "/penugasan/get_detail";
        var param = {            
            idpenugasan : id
        };
        $("body").loading('start');
        var req = $.post(url, param).done(function (data) {        
            if (data) {
                load_data(data);
            }
        })
        .always(function() {
            $("body").loading('stop');
        });
    }
    
