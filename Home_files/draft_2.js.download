                    var data = result;
                    if (data.status) {                
                        $('#modal-penugasan').modal('hide');
                        //$.notify({title: "Information", message: data.message}, {type: "success", delay: 3});                        
                        swal(data.message, { 
                                            icon: "success",
                                            });     
                                            
                        if (data.data) {
                            //var dt = JSON.stringify(data.data); 
                            //$('#data-detail').html(dt);
                            filter_dokumen();                       
                            $('#frm-penugasan')[0].reset();
                            $('#frm-penugasan [name=idpenugasan]').val("");     
                        }
                        return;                        
                    } else {                                            
                        //$('#modal-tugas').modal('show');
                        //$.notify({title: "Information", message: data.message}, {type: "error", delay: 3});                        
                        swal(data.message, { 
                                            icon: "error",
                                            });    
                    }
                } catch (err) {
                    $.notify({title: "Information", message: err.message}, {type: "error", delay: 3});
                }                               
            }
        };      
        /**
        $("#frm-penugasan input.rupiah").val(function (){
            return $(this).maskMoney('unmasked')[0];
        });	
        */
        $("body").loading('start');
        //$('#modal-tugas').modal('hide');
        $(".btn-save-penugasan").attr("disabled", true);
        $('#frm-penugasan').ajaxForm(options).submit();                
        
    });
    
    dok_delete = function(id) {
        swal({
        title: "Apakah Anda yakin?",
                text: "Apakah Anda yakin untuk menghapus data ini.",
                icon: "warning",
                buttons: true,
                dangerMode: true,
        })
        .then((willSave) => {
            if (willSave) {                
                var url = appBaseUrl + "/penugasan/delete";
                var param = {                    
                    idpenugasan : id
                };
                $("body").loading('start');
                var req = $.post(url, param).done(function (rs) {
                        if (rs) {                            
                            if (rs.status) {
                                swal("Proses Berhasil dengan Kode: ("+ id +")", { 
                                    icon: "success",
                                    });                              
                                filter_dokumen();
                                return;
                            } else {
                                $.notify({title: "Information", message: rs.message}, {type: "error", delay: 3000});                                
                                return;
                            }
                        } else
                        $.notify({title: "Information", message: "Request tidak dapat diproses!"}, {type: "error", delay: 3000});
                    })
                   .always(function() {                       
                       $("body").loading('stop');
                   });
            } else {
                swal("Batal", "Proses Dibatalkan!", "info");
            }
        }); 
    }
    
