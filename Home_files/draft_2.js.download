    filter_dokumen = function(){
        $("body").loading('start');
        var url = appBaseUrl + "/penugasan/find_draft";        
        var param = {
            tahun : $('#frm-filter [name=tahun]').val(),            
            judul : $('#frm-filter [name=judul]').val(), 
            idjenispenugasan : $('#frm-filter [name=jenis]').val(),
            id_kategori_unit : $('#frm-filter [name=id_kategori_unit]').val(),
            id_jenjang : $('#frm-filter [name=id_jenjang]').val()
        };
        var req = $.get(url, param).done(function (data) {
            // Kolom auditor tampil jika pengguna berhak mengaudit minimal satu baris; hak dihitung server per penugasan
            var canAudit = false;
            window.draftRowAkses = {};
            if (data && data.length) {
                $.each(data, function(_, r) {
                    window.draftRowAkses[r.idpenugasan] = { audit: !!r.bisa_audit, mandiri: !!r.bisa_isi_mandiri };
                    if (r.bisa_audit) canAudit = true;
                });
            }
            var t = '<table class="table table-hover table-bordered" id="tb-dokumen" width="100%"><thead><tr>'+
                '<th rowspan="2" style="vertical-align:middle;">Judul Penugasan</th>'+
                '<th rowspan="2" style="vertical-align:middle;">Auditee</th>'+
                '<th colspan="3" class="text-center" style="vertical-align:middle;">Waktu Pelaksanaan</th>'+
                '<th rowspan="2" style="min-width:170px; vertical-align:middle;" class="text-center">Penilaian Mandiri<br><small class="text-primary" style="font-weight:700;">(Auditee)</small></th>'+
                (canAudit ? '<th rowspan="2" style="min-width:170px; vertical-align:middle;" class="text-center">Penilaian Auditor<br><small class="text-green" style="font-weight:700;">(Auditor)</small></th>' : '') +
                '<th rowspan="2" style="vertical-align:middle;" class="text-center">Status</th>'+
                '<th rowspan="2" style="min-width:110px; vertical-align:middle;" class="text-center">Aksi</th>'+
            '</tr>\n\
            <tr><th class="text-center">Mulai</th><th class="text-center">Selesai</th><th class="text-center">Durasi (hari)</th></tr></thead><tbody>';
        if (data && data.length >0) {
            $.each(data, function(i, obj) {                            
                var d = JSON.stringify(obj);
                var h = "<input type='hidden' value='" + d + "'/>";             
                if (!obj.catatan) obj.catatan = '';
                var url='';                             
                if (!obj.durasi) obj.durasi = '';

                // --- 1. Kolom Penilaian Mandiri (Auditee) ---
                var totalWajib = (obj.total_wajib !== undefined && obj.total_wajib !== null) ? parseInt(obj.total_wajib) : 0;
                var terisiWajib = (obj.terisi_wajib !== undefined && obj.terisi_wajib !== null) ? parseInt(obj.terisi_wajib) : 0;
                var persenWajib = (obj.persen_wajib !== undefined && obj.persen_wajib !== null) ? parseFloat(obj.persen_wajib) : (parseFloat(obj.persen) || 0);

                var barColorMandiri = 'progress-bar-primary';
                var badgeStatusMandiri = '';
                if (obj.is_submitted_auditee) {
                    barColorMandiri = 'progress-bar-success';
                    badgeStatusMandiri = '<span class="label label-success pull-right" style="font-size:10px;"><i class="fa fa-lock"></i> Disubmit</span>';
                } else if (obj.is_expired_auditee) {
                    // Terkunci karena lewat batas waktu padahal belum disubmit: jangan tampil "Selesai"
                    barColorMandiri = 'progress-bar-danger';
                    badgeStatusMandiri = '<span class="label label-danger pull-right" style="font-size:10px;"><i class="fa fa-lock"></i> Lewat Batas</span>';
                } else if (totalWajib > 0 && terisiWajib >= totalWajib) {
                    barColorMandiri = 'progress-bar-success';
                    badgeStatusMandiri = '<span class="label label-success pull-right" style="font-size:10px;"><i class="fa fa-check"></i> Lengkap</span>';
                } else if (terisiWajib > 0) {
                    barColorMandiri = 'progress-bar-warning';
                    badgeStatusMandiri = '<span class="label label-warning pull-right" style="font-size:10px;">Proses</span>';
                } else {
                    barColorMandiri = 'progress-bar-danger';
                    badgeStatusMandiri = '<span class="label label-default pull-right" style="font-size:10px;">Belum Diisi</span>';
                }

                var wajibLabel = (totalWajib > 0) ? (terisiWajib + '/' + totalWajib + ' Wajib') : '0 Wajib';

                var deadlineAuditeeText = '';
                if (obj.deadline_auditee) {
                    deadlineAuditeeText = '<div class="text-muted text-center" style="font-size:10px; margin-top:3px;" title="Batas Waktu Pengisian Mandiri"><i class="fa fa-clock-o"></i> Batas: ' + obj.deadline_auditee.substring(0, 10) + '</div>';
                }

                var cellAuditee = '<div class="clearfix" style="margin-bottom:3px;">' +
                    '<small class="pull-left"><b>' + wajibLabel + '</b></small>' +
                    badgeStatusMandiri +
                    '</div>' +
                    '<div class="progress xs" style="margin-bottom:2px; height:8px; border-radius:4px; background:#e9ecef;">' +
                    '<div class="progress-bar ' + barColorMandiri + '" style="width: ' + persenWajib + '%; border-radius:4px;"></div>' +
                    '</div>' +
                    '<div class="text-right"><small style="font-size:10px; color:#666;"><b>' + persenWajib + '%</b> terisi</small></div>' +
                    (obj.bisa_isi_mandiri
                        ? '<a href="' + appBaseUrl + '/penugasan/penilaian_mandiri/' + obj.idpenugasan + '" class="btn btn-xs btn-primary btn-block" style="margin-top:5px; font-weight:600;"><i class="fa fa-list-alt"></i> ' + (obj.is_locked_auditee ? 'Lihat Penilaian Mandiri' : 'Isi Penilaian Mandiri') + '</a>'
                        : '<a href="' + appBaseUrl + '/penugasan/penilaian_mandiri/' + obj.idpenugasan + '" class="btn btn-xs btn-default btn-block" style="margin-top:5px; font-weight:600;" title="Anda tidak berperan mengisi penilaian mandiri pada penugasan ini"><i class="fa fa-eye"></i> Lihat (hanya-baca)</a>') +
                    deadlineAuditeeText;

                // --- 2. Kolom Penilaian Auditor (Auditor) ---
                var totalButir = (obj.total_butir !== undefined && obj.total_butir !== null) ? parseInt(obj.total_butir) : 0;
                var terisiAudit = (obj.terisi_audit !== undefined && obj.terisi_audit !== null) ? parseInt(obj.terisi_audit) : 0;
                var persenAudit = (obj.persen_audit !== undefined && obj.persen_audit !== null) ? parseFloat(obj.persen_audit) : 0;

                var barColorAudit = 'progress-bar-success';
                var badgeStatusAudit = '';
                if (obj.is_finished_auditor) {
                    barColorAudit = 'progress-bar-success';
                    badgeStatusAudit = '<span class="label label-success pull-right" style="font-size:10px;"><i class="fa fa-check-circle"></i> Selesai</span>';
                } else if (totalButir > 0 && terisiAudit >= totalButir) {
                    barColorAudit = 'progress-bar-success';
                    badgeStatusAudit = '<span class="label label-success pull-right" style="font-size:10px;"><i class="fa fa-check"></i> Lengkap</span>';
                } else if (!obj.is_locked_auditee) {
                    // Auditor baru bisa menilai setelah auditee submit / melewati batas waktu
                    barColorAudit = 'progress-bar-info';
                    badgeStatusAudit = '<span class="label label-default pull-right" style="font-size:10px;"><i class="fa fa-hourglass-half"></i> Menunggu Auditee</span>';
                } else if (obj.is_expired_auditor) {
                    barColorAudit = 'progress-bar-danger';
                    badgeStatusAudit = '<span class="label label-danger pull-right" style="font-size:10px;">Lewat Batas</span>';
                } else if (terisiAudit > 0) {
                    barColorAudit = 'progress-bar-warning';
                    badgeStatusAudit = '<span class="label label-warning pull-right" style="font-size:10px;">Proses</span>';
                } else {
                    barColorAudit = 'progress-bar-info';
                    badgeStatusAudit = '<span class="label label-default pull-right" style="font-size:10px;">Belum Dinilai</span>';
                }

                var auditLabel = (totalButir > 0) ? (terisiAudit + '/' + totalButir + ' Butir') : '0 Butir';

                var deadlineAuditorText = '';
                if (obj.deadline_auditor) {
                    deadlineAuditorText = '<div class="text-muted text-center" style="font-size:10px; margin-top:3px;" title="Batas Waktu Penilaian Auditor"><i class="fa fa-calendar-check-o"></i> Batas: ' + obj.deadline_auditor.substring(0, 10) + '</div>';
                }

                var cellAuditor = '<div class="clearfix" style="margin-bottom:3px;">' +
                    '<small class="pull-left"><b>' + auditLabel + '</b></small>' +
                    badgeStatusAudit +
                    '</div>' +
                    '<div class="progress xs" style="margin-bottom:2px; height:8px; border-radius:4px; background:#e9ecef;">' +
                    '<div class="progress-bar ' + barColorAudit + '" style="width: ' + persenAudit + '%; border-radius:4px;"></div>' +
                    '</div>' +
                    '<div class="text-right"><small style="font-size:10px; color:#666;"><b>' + persenAudit + '%</b> dinilai</small></div>' +
                    '<a href="' + appBaseUrl + '/penugasan/audit_rubrik/' + obj.idpenugasan + '" class="btn btn-xs btn-success btn-block" style="margin-top:5px; font-weight:600;"><i class="fa fa-gavel"></i> Audit Rubrik</a>' +
                    deadlineAuditorText;

                // --- 3. Kolom Aksi ---
                var btnDetail = '<button class="btn btn-xs btn-info btn-detail" onclick="dok_detail(\''+obj.idpenugasan+'\')" data-toggle="tooltip" data-placement="auto" title="Detil Penugasan" style="margin:2px;"><i class="fa fa-info-circle"></i> Detil</button>';
                var btnAksi = '<button class="btn btn-xs btn-warning btn-edit" onclick="dok_edit(\''+obj.idpenugasan+'\')" data-toggle="tooltip" data-placement="auto" title="Overview Singkat" style="margin:2px;"><i class="fa fa-pencil-square"></i></button>';
                
                if (obj.status == 'Draft' || obj.status == 'Submitted' || obj.status == 'Active') {
                    btnAksi += '<button class="btn btn-xs btn-danger btn-delete" onclick="dok_delete(\''+obj.idpenugasan+'\')" data-toggle="tooltip" data-placement="auto" title="Hapus Draft" style="margin:2px;"><i class="fa fa-trash"></i></button>';
                }
                if (obj.status == 'Draft') {
                    btnAksi += '<button class="btn btn-xs btn-primary" onclick="dok_submit(\''+btoa(obj.idpenugasan)+'\')" data-toggle="tooltip" data-placement="auto" title="Submit Draft Penugasan" style="margin:2px;"><i class="fa fa-send"></i></button>';
                }

                var label = 'label-primary';
                if (obj.idstatus == 'draft') label = 'label-default';
                else if (obj.idstatus == 'revision') label = 'label-warning';
                else if (obj.idstatus == 'rejected') label = 'label-danger';
                else if (obj.idstatus == 'inprogress') label = 'label-success';
                
                if (!obj.tglselesai) obj.tglselesai = '';
                
                var katBadge = '';
                if (obj.nama_kategori_unit) {
                    katBadge = '<br/><span class="label label-default" style="font-size:10px; font-weight:normal; background-color:#f4f6f9; color:#444; border:1px solid #d2d6de;"><i class="fa fa-tag text-muted"></i> ' + obj.nama_kategori_unit + (obj.nama_jenjang ? ' &bull; ' + obj.nama_jenjang : '') + '</span>';
                }

                t+= '<tr>' +
                    '<td><b>'+obj.judul+ h +'</b><br/><span class="text-info">'+obj.deskripsi+'</span></td>'+                                                                             
                    '<td>'+obj.auditee+'<br/><span class="text-info">'+obj.unit+'</span>' + katBadge + '</td>'+   
                    '<td>'+obj.tglmulai+'</td><td>'+obj.tglselesai+'</td><td align="center">'+obj.durasi+'</td>'+
                    '<td>'+cellAuditee+'</td>'+
                    (canAudit ? ('<td>' + (obj.bisa_audit ? cellAuditor : '<div class="text-center text-muted" title="Anda tidak berperan sebagai auditor pada penugasan ini">&mdash;</div>') + '</td>') : '') +
                    '<td align="center"><span class="label '+ label +'">'+obj.status+'</span></td>'+
                    '<td align="center">'+btnDetail+btnAksi+'</td></tr>';
            });
    }            
            t+= '</tbody>';
            //t+='<tfoot><tr><th colspan="5" align="right">Total</th><th></th><th></th><th></th><th></th></tr></tfoot>';
            t+='</table>';            
            $('.div-penugasan').html(t);
            /**
              {
                        text: 'Tambah Penugasan',
                        className: 'btn-primary text-white',
                        action: function (e, dt, node, config) {
                            $("#frm-penugasan")[0].reset();
                            $("#frm-penugasan [name=idpenugasan]").val("");                            
                            $("#modal-penugasan").modal('show');
                        }
                    },
             */
            tablePenugasan = $('#tb-dokumen').DataTable({
                dom: 'Blfrtip',
                buttons: [                    
                    'excel'
                ],
                width: "100%",
                scrollX: false,
                lengthMenu: [ 10, 50, 100, 500, 1000],
                order: [[ 3, "desc" ]]
            });
            
            $('#tb-dokumen tbody').on('click', 'tr', function () {
                        var d = $(this).find('input[type="hidden"]').val();
                        if (d) {
                            if ($(this).hasClass('selected')) {
                                $(this).removeClass('selected');                                
                            } else {
                                tablePenugasan.$('tr.selected').removeClass('selected');
                                $(this).addClass('selected');
                                /**
                                var obj = JSON.parse(d);
                                for (var key in obj) {
                                    try {
                                        $(' [name=' + key + ']').val(obj[key]);
                                    } catch (err) {
                                    }
                                }                                
                                */
                               $('#tmp-data').html(d);
                            }
                        }
                    });
        })
        .always(function() {
            $("body").loading('stop');
        });
    };

    checkKategoriJenjang = function() {
        var $sel = $('#filter-kategori-unit option:selected');
        var val = $('#filter-kategori-unit').val();
        var kode = ($sel.data('kode') || '').toString().toUpperCase();
        var text = ($sel.text() || '').toLowerCase();

        var isProdi = (val === '2' || kode === 'PRODI' || text.indexOf('program studi') !== -1 || text.indexOf('prodi') !== -1);

        if (isProdi) {
            $('#wrapper-filter-jenjang').show();
            $('#filter-jenjang').prop('disabled', false);
        } else {
            $('#wrapper-filter-jenjang').hide();
            $('#filter-jenjang').val('').prop('disabled', true);
        }
    };

    reset_filter = function() {
        var d = new Date();
        $('#frm-filter [name=tahun]').val(d.getFullYear());
        $('#frm-filter [name=jenis]').val('');
        $('#frm-filter [name=judul]').val('');
        $('#filter-kategori-unit').val('');
        $('#filter-jenjang').val('');
        checkKategoriJenjang();
        filter_dokumen();
    };

    $('#filter-kategori-unit').on('change', function() {
        checkKategoriJenjang();
        filter_dokumen();
    });

    $('#filter-jenjang').on('change', function() {
        filter_dokumen();
    });

    $('#frm-filter [name=tahun], #frm-filter [name=jenis]').on('change', function() {
        filter_dokumen();
    });

    $('#frm-filter [name=judul]').on('keypress', function(e) {
        if (e.which === 13) {
            e.preventDefault();
            filter_dokumen();
        }
    });

    checkKategoriJenjang();
    filter_dokumen();
});

