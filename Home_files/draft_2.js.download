$(function(){
    $('.block-info').hide();
    $('.div-comment').hide();
    $('.div-logbook').hide();
    var tablePenugasan = null;
    validateSize=function(input) {
        const fileSize = input.files[0].size / 1024 / 1024; // in MiB
        if (fileSize > 3) {
            $.notify({title: "Information", message: 'Maksimal ukuran file 3M'}, {type: "error", delay: 3000});
            $(".btn-unggah-berkas").prop('disabled',true);
        }else $(".btn-unggah-berkas").prop('disabled',false);
    }
    
    $("#frm-berkas-versi .btn-file").click(function () {
        $("#frm-berkas-versi .btn-file").removeClass("btn-primary");
        $(this).addClass("btn-primary");

        if($(this).hasClass("btn-berkas")){
            $("#frm-berkas-versi [name='fileToUpload']").show();
            $("#frm-berkas-versi [name='tautan']").hide();

            $("#frm-berkas-versi [name='fileToUpload']").prop("required", false);
            $("#frm-berkas-versi [name='tautan']").prop("required", false);
        }else{
            $("#frm-berkas-versi [name='fileToUpload']").hide();
            $("#frm-berkas-versi [name='tautan']").show();

            $("#frm-berkas-versi [name='fileToUpload']").prop("required", false);
            $("#frm-berkas-versi [name='tautan']").prop("required", false);
        }
    });
    
    $("#frm-komentar .btn-file").click(function () {
        $("#frm-komentar .btn-file").removeClass("btn-primary");
        $(this).addClass("btn-primary");

        if($(this).hasClass("btn-berkas")){
            $("#frm-komentar [name='fileToUpload']").show();
            $("#frm-komentar [name='tautan']").hide();

            $("#frm-komentar [name='fileToUpload']").prop("required", false);
            $("#frm-komentar [name='tautan']").prop("required", false);
        }else{
            $("#frm-komentar [name='fileToUpload']").hide();
            $("#frm-komentar [name='tautan']").show();

            $("#frm-komentar [name='fileToUpload']").prop("required", false);
            $("#frm-komentar [name='tautan']").prop("required", false);
        }
    });
    /**
    $("#frm-berkas .btn-file").click(function () {
        
    });
    */
    initSelect2Pegawai($("#frm-penugasan [name=idauditee]"), $("#modal-penugasan"));
    initSelect2IdUnit($("#frm-penugasan [name=idunitpenugasan]"), $("#modal-penugasan"));
    
    initSelect2Pegawai($("#frm-dokumen [name=idauditee]"), '');
    initSelect2IdUnit($("#frm-dokumen [name=idunitpenugasan]"), '');
    
    initSelect2Pegawai($("#frm-pengguna [name=idpegawai]"), $("#modal-pengguna"));
    
    filter_tim = function(id){        
        var url = appBaseUrl + "/penugasan/find_tim";
        var param = {
            idpenugasan : id            
        };
        $('.div-tim').html("");
        var req = $.get(url, param).done(function (data) {
            
            var t = '<table class="table table-condensed table-hover" width="100%" id="tb-personil">'+
                '<tbody>';                        
            //var no = 0;      
            if (data && data.length > 0) {                            
                    var content='';                    
                    $.each(data, function(i, obj) {
                        var d = JSON.stringify(obj);
                        var h = "<input type='hidden' value='" + d + "'/>";                        
                        //no++;                                                                                                                        
                        content += '<tr>' +
                            //'<td align="center">' + no + '</td>' +
                            '<td><b>' + obj.nama + h + '</b><br/>' + obj.tagidentitas + '. ' + obj.nomoridentitas + '</td>' +
                            '<td>' + (!obj.peran ? '' : obj.peran) + '</td>' +                            
                            '<td><button class="btn btn-sm btn-danger btn-hapus-tim" onclick="delete_tim(\'' + btoa(obj.idpenugasanpegawai) + '\')"><i class="fa fa-trash"></i></button></td></tr>';
                        
                    });
                    t += content;                

            } else {
                 t += '<tr><td align="center"><small><i>Belum ada data.</i></small></td></tr>';
            }            
            t += '</tbody> </table>';
            //<button class="btn btn-sm btn-primary btn-ref" onclick="dok_referensi('+obj.id_dokumen+')"><i class="fa fa-navicon"></i>&nbsp; Dok. Referensi</button>&nbsp;
            $('.div-tim').html(t);
        })
        .always(function() {
            
        });
    };
    
    $("#evt-aktifitas").on("click", function () {
        filter_berkas($('#frm-berkas [name=idpenugasan]').val());
    });
    
    $("#frm-berkas .btn-save-berkas").on("click", function () {
        var options = {
            target: '',
            success: function (result) {
                $("body").loading('stop');
                try {                    
                    var data = result;
                    if (data.status) {                                                                        
                        //$.notify({title: "Information", message: data.message}, {type: "success", delay: 3});                                                
                        swal(data.message, { 
                                            icon: "success",
                                            });  
                                            
                        var checkDiv = $('.div-table-' + $('#frm-berkas [name=idtahapan]').val()).html();    
                        if (!checkDiv || checkDiv == '')
                            filter_berkas($('#frm-berkas [name=idpenugasan]').val()); 
                        else
                            filter_berkas_tahapan($('#frm-berkas [name=idpenugasan]').val(), $('#frm-berkas [name=idtahapan]').val());
                        return;                        
                    }                    
                    //$.notify({title: "Information", message: data.message}, {type: "error", delay: 3});
                    swal(data.message, { 
                                            icon: "error",
                                            });  
                } catch (err) {
                    //$.notify({title: "Information", message: err.message}, {type: "error", delay: 3});
                    swal(err.message, { 
                                            icon: "error",
                                            });  
                }                               
            }
        };
        $("body").loading('start');
        $('#frm-berkas').ajaxForm(options).submit();
        $('#modal-berkas').modal('hide');
    });
    
    $("#frm-berkas-versi .btn-save-berkas-versi").on("click", function () {
        var options = {
            target: '',
            success: function (result) {
                $("body").loading('stop');
                try {                    
                    var data = result;
                    /**
                    if (data.status) {                                                                        
                        //$.notify({title: "Information", message: data.message}, {type: "success", delay: 3});                                                
                        swal(data.message, { 
                                            icon: "success",
                                            });  
                                
                        var checkDiv = $('.div-table-' + $('#frm-berkas [name=idtahapan]').val()).html();    
                        if (!checkDiv || checkDiv == '')
                            filter_berkas($('#frm-berkas [name=idpenugasan]').val()); 
                        else
                            filter_berkas_tahapan($('#frm-berkas [name=idpenugasan]').val(), $('#frm-berkas [name=idtahapan]').val());
                        return;                       
                        
                    }                    
                    */
                    //$.notify({title: "Information", message: data.message}, {type: "error", delay: 3});
                    swal(data.message, { 
                                            icon: "success",
                                            });  
                    /**
                    var checkDiv = $('.div-table-' + $('#frm-berkas [name=idtahapan]').val()).html();    
                    if (!checkDiv || checkDiv == '')
                        filter_berkas($('#frm-berkas [name=idpenugasan]').val()); 
                    else */
                    var dtHtml = $('#tmp-data-aktifitas').html();
                    if (dtHtml) {
                        var pt = JSON.parse(dtHtml);
                        filter_berkas_tahapan(pt.idpenugasan, pt.idtahapan);
                    }
                        
                } catch (err) {
                    //$.notify({title: "Information", message: err.message}, {type: "error", delay: 3});
                    swal(err.message, { 
                                            icon: "error",
                                            });  
                }                               
            }
        };
        $("body").loading('start');
        $('#frm-berkas-versi').ajaxForm(options).submit();
        $('#modal-berkas-versi').modal('hide');
    });
    
    preview_berkas = function(l){
        var url =  atob(l);
        $('.div-comment').hide();
        $('.div-logbook').hide();
        $('#div-preview').attr("src", url).show();
    };
    
    unduh_berkas = function(l){        
        var url = baseUrl + '/' + atob(l);
        $('.div-comment').hide();
        $('.div-logbook').hide();
        $('#div-preview').attr("src", url).show();
    };
    
    $('.btn-save-komentar').click(function () {
        var options = {
            target: '',
            success: function (result) {
                $(".btn-save-komentar").removeAttr("disabled");
                $("body").loading('stop');
                find_komentar($('#frm-komentar [name=idpenugasantahapanberkas]').val());                
            }
        };           
        $("body").loading('start');        
        $(".btn-save-komentar").attr("disabled", true);
        $('#frm-komentar').ajaxForm(options).submit();                
        
    });
    
    find_komentar = function(id){
        if (!id) return;
        
        $('#chat-box').html("")
        var url = appBaseUrl + "/komentar/find";
        var param = {
            idpenugasantahapanberkas : id            
        };
        var req = $.post(url, param).done(function (data) {
            if (data) {        
                var tag = ''; 
                    $.each(data, function(i, obj) {
                        tag += '<div class="item"> <img src="'+baseUrl+'/assets/images/user.png" class="user-image" alt="User Image">';
                        tag +='<p class="message"> <a href="#" class="name"><small class="text-muted pull-right"><i class="fa fa-clock-o"></i>'+obj.timestamp+'</small> '+obj.nama+'  </a> '+obj.komentar+'    </p>';
                        if (obj.tautan) {
                            tag += '<div class="attachment"> <h4>Attachments:</h4><p class="filename"> '+obj.tautan+' </p>\n\
 <div class="pull-right">  <a href="'+obj.tautan+'" class="btn btn-primary" target="_blank">Buka Tautan</a> </div></div>';
                        }    
                        //<button type="button" class="btn btn-primary btn-sm btn-flat" onclick="location.href='+obj.tautan+';" target="_blank">Buka</button>
                        if (obj.lampiran) {
                            tag += '<div class="attachment"> <h4>Attachments:</h4><p class="filename"> '+obj.judullampiran+' </p>\n\
 <div class="pull-right">  <a href="'+baseUrl+'/'+obj.lampiran+'" class="btn btn-primary" target="_blank">Buka</a></div></div>';
                        } 
                        // <button type="button" class="btn btn-primary btn-sm btn-flat" onclick="location.href='+obj.lampiran+';" target="_blank">Buka</button>
                        tag +='</div>';    
                    });                               
                $('#chat-box').html(tag)
            }
        })
        .always(function() {
            
        });
        
    }
    
    hapus_verifikator = function(id, ip) {        
        swal({
        title: "Apakah Anda yakin?",
                text: "Apakah Anda yakin untuk menghapus data ini.",
                icon: "warning",
                buttons: true,
                dangerMode: true,
        })
        .then((willSave) => {
            if (willSave) {                
                var url = appBaseUrl + "/penugasan/hapus_verifikator";
                var param = {            
                    idpenugasantahapanberkas : atob(id),
                    idpenugasanpegawai : atob(ip)
                };
                $("body").loading('start');
                var req = $.post(url, param).done(function (data) {
                    if (data) {
                        if (data.status) {
                            swal("Data berhasil dihapus.", { 
                                            icon: "success",
                                            });  
                            lacak_verif_berkas(-1, atob(id));                    
                            //filter_tim($('#frm-berkas [name=idpenugasan]').val());
                        }
                    }
                })
                    .always(function() {
                        $("body").loading('stop');
                    });
            } else {
                swal("Batal", "Proses Dibatalkan!", "info");
            }
        });                        
    };
    
    lacak_verif_berkas = function(i, id){
        if (!id) return;
        $('#modal-lacak').modal('show'); 
        $('.div-lacak').html("")
        var url = appBaseUrl + "/verifikasi/find";
        var param = {
            idpenugasantahapanberkas : id            
        };
        var req = $.post(url, param).done(function (data) {
            var tag = '<table class="table table-hover table-condensed"><thead><tr><th>No</th><th>Verifikator</th><th>Status</th><th>Catatan</th><th>Tautan</th><th>Aksi</th></tr></thead><tbody>'
            if (data) {                
                    $.each(data, function(i, obj) {                                                
                        var status = '<span class="label label-danger"><i class="fa fa-question-circle"></i> Belum diverifikasi</span>';
                        if (!obj.verifiednote) obj.verifiednote = '';
                        if (obj.verifiedby) {  
                            if (obj.verified == '1')
                                status = '<span class="label label-success"><i class="fa fa-check-circle"></i> Disetujui</span>' + '<br><small><i>'+ obj.verifiedby +': '+ obj.verifiedtime + '</i></small>';
                            else if (obj.verified == '2')
                                status = '<span class="label label-warning"><i class="fa fa-warning"></i> Revisi</span>' + '<br><small><i>'+ obj.verifiedby +': '+ obj.verifiedtime + '</i></small>';
                            else if (obj.verified == '3')
                                status = '<span class="label label-danger"><i class="fa fa-ban"></i> Ditolak</span>' + '<br><small><i>'+ obj.verifiedby +': '+ obj.verifiedtime + '</i></small>';
                        }
                        var btnTautan = '';
                        if (obj.tautan) {
                            btnTautan += '<button class="btn btn-sm btn-default" onclick="preview_berkas(\''+btoa(obj.tautan)+'\')"><i class="fa fa-link"></i></button>';
                        }
                        if (obj.lampiran) {
                            btnTautan += '<button class="btn btn-sm btn-default" onclick="unduh_berkas(\''+btoa(obj.lampiran)+'\')"><i class="fa fa-file-archive"></i></button>';
                        }
                        var btnHapus = '';
                        if (!obj.verified) {
                            btnHapus = '<button class="btn btn-sm btn-danger" onclick="hapus_verifikator(\''+btoa(obj.idpenugasantahapanberkas)+'\',\''+btoa(obj.idpenugasanpegawai)+'\')"><i class="fa fa-trash"></i></button>';
                        }
                        tag +='<tr><td>'+obj.nourut+'</td><td>'+obj.nama+'<br>'+ obj.tag_identitas +'. '+ obj.nomor_identitas +'<br><span class="label label-primary">'+obj.peran+'<span></td><td>'+status+'</td><td><span class="text-info">' +obj.verifiednote 
                                + '</span></td><td>'+btnTautan+'</td><td>'+btnHapus+'</td></tr>';
                    });                               
            }
            tag +='</tbody></table>'
            $('.div-lacak').html(tag);
        })
        .always(function() {
            
        });
        
    }
    
    softdelete_berkas = function(i, id) {        
        swal({
        title: "Apakah Anda yakin?",
                text: "Apakah Anda yakin untuk menghapus data ini.",
                icon: "warning",
                buttons: true,
                dangerMode: true,
        })
        .then((willSave) => {
            if (willSave) {                
                var url = appBaseUrl + "/penugasan/soft_delete_berkas";
                var param = {            
                    idpenugasantahapanberkas : i,
                    idpenugasanberkas : id
                };
                $("body").loading('start');
                var req = $.post(url, param).done(function (data) {
                    if (data) {
                        if (data.status) {
                            swal("Data berhasil dihapus.", { 
                                            icon: "success",
                                            });            
                            //filter_berkas(i);
                            dok_versi(i);
                        }
                        var dtHtml = $('#tmp-data-aktifitas').html();
                        if (dtHtml) {
                            var pt = JSON.parse(dtHtml);
                            filter_berkas_tahapan(pt.idpenugasan, pt.idtahapan);
                        }
                    }
                })
                    .always(function() {
                        $("body").loading('stop');
                    });
            } else {
                swal("Batal", "Proses Dibatalkan!", "info");
            }
        });                        
    };
    
    dok_versi = function(id){
        if (!id) return;
        $('#modal-versi').modal('show'); 
        $('.div-versi').html("")
        var usr = atob($('#app-usr').html());
        var url = appBaseUrl + "/penugasan/find_versi_berkas";
        var param = {
            idpenugasantahapanberkas : id            
        };
        var req = $.post(url, param).done(function (data) {
            var tag = '<table class="table table-hover table-bordered"><thead><tr><th>No</th><th>Nama Berkas</th><th>Catatan</th><th>Tautan</th><th>Waktu Unggah</th><th>Opsi</th></tr></thead><tbody>'
            if (data) {
                var no = 0;                
                    $.each(data, function(i, obj) {                        
                        no++;
                        var btnTautan = '';
                        if (obj.tautan) {
                            btnTautan += '<button class="btn btn-sm btn-default" onclick="preview_berkas(\''+btoa(obj.tautan)+'\')"><i class="fa fa-link"></i></button>';
                        }
                        if (obj.lampiran) {
                            btnTautan += '<button class="btn btn-sm btn-default" onclick="unduh_berkas(\''+btoa(obj.lampiran)+'\')"><i class="fa fa-file-archive"></i></button>';
                        }
                        
                        if (!obj.versi) obj.versi = '';
                        if (!obj.judul && obj.tautan) obj.judul = obj.tautan;
                        var btnAksi = '';
                        if (usr == obj.username) {
                            btnAksi = '<button class="btn btn-sm btn-danger" title="Hapus Berkas" onclick="softdelete_berkas(\''+obj.idpenugasantahapanberkas+'\',\''+obj.idpenugasanberkas+'\')"><i class="fa fa-trash"></i></button>';
                        }
                        tag +='<tr><td>'+no+'</td><td>'+obj.judul+'<br>versi: '+ obj.versi +'</td><td><span class="text-info">' +obj.catatan + '</span></td><td>'+ btnTautan +'</td><td>'+ obj.timestamp +'</td><td>'+ btnAksi +'</td></tr>';
                    });                               
            }
            tag +='</tbody></table>'
            $('.div-versi').html(tag);
        })
        .always(function() {
            
        });
        
    }
    
    dok_versi_tambah = function(id){
        if (!id) return;
        $('#modal-berkas-versi').modal('show');        
        $('#frm-berkas-versi')[0].reset();                    
        $('#frm-berkas-versi [name=idpenugasanberkas]').val("");       
        $('#frm-berkas-versi [name=idpenugasantahapanberkas]').val(id);     
        
        var raw = $('#tmp-data-aktifitas').html();
        var obj = JSON.parse(raw);
        if (obj) {
            $('#frm-berkas-versi [name=idpenugasan]').val(obj.idpenugasan);       
        }
    }
    
    edit_berkas = function(i, id) {       
        if (!id) return;
        $('#modal-berkas').modal('show');        
        $('#frm-berkas')[0].reset();                    
        $('#frm-berkas [name=idpenugasantahapanberkas]').val(id);                
        
        var url = appBaseUrl + "/penugasan/get_berkas";
        var param = {
            idpenugasantahapanberkas : id            
        };
        var req = $.post(url, param).done(function (data) {
            if (data) {
                var obj = data;
                for( var key in obj ) {
                    var value = obj[key];
                    $('#frm-berkas [name='+key+']').val(value);   
                }              
            }
        })
        .always(function() {
            
        });
    };
    
    dok_lacak = function(id) {
        if (!id) return;
        $('#modal-lacak').modal('show'); 
        $('.div-lacak').html("")
        var url = appBaseUrl + "/verifikasi/find_penugasan";
        var param = {
            idpenugasan: atob(id)            
        };
        var req = $.post(url, param).done(function (data) {
            var tag = '<table class="table table-hover table-bordered"><thead><tr><th>No</th><th>Nama</th><th>Peran</th><th>Status</th></tr></thead><tbody>'
            if (data) {                
                    $.each(data, function(i, obj) {                                                                                                                    
                        var verified = '';
                        if (obj.verified == 1) {
                            verified = '<span class="label label-success">Disetujui</span>';
                        } else if (obj.verified == 2) {
                            verified = '<span class="label label-warning">Revisi</span>';
                        } else if (obj.verified == 3) {
                            verified = '<span class="label label-danger">Ditolak</span>';
                        } else {
                            verified = '<span class="label label-default">Belum Diverifikasi</span>';
                        }
                        if (!obj.verifiednote) obj.verifiednote = '';
                        tag +='<tr><td>'+obj.nourut+'</td><td>'+obj.nama+'<br>'+ obj.tag_identitas +'. '+ obj.nomor_identitas +'</td><td><span class="label label-primary">'+obj.peran+'<span></td><td>'+verified+'<br><span class="text-info">Catatan: '+obj.verifiednote+'</span></td></tr>';
                    });                               
            }
            tag +='</tbody></table>'
            $('.div-lacak').html(tag);
        })
        .always(function() {
            
        });
    }
    
    dok_submit = function(i) {
        swal({
        title: "Apakah Anda yakin?",
                text: "Apakah Anda yakin untuk meng-submit penugasan ini.",
                icon: "warning",
                buttons: true,
                dangerMode: true,
        })
        .then((willSave) => {
            if (willSave) {                
                var url = appBaseUrl + "/penugasan/submit";
                var param = {            
                    idpenugasan : atob(i)
                };
                $("body").loading('start');
                var req = $.post(url, param).done(function (data) {
                    if (data) {
                        if (data.status) {
                            swal("Penugasan berhasil disubmit.", { 
                                            icon: "success",
                                            });                                        
                            filter_dokumen();
                        } else {
                            swal(data.message, { 
                                            icon: "error",
                                            });      
                        }
                    }
                })
                    .always(function() {
                        $("body").loading('stop');
                    });
            } else {
                swal("Batal", "Proses Dibatalkan!", "info");
            }
        });           
    }
    
    delete_berkas = function(i, id) {
        
        swal({
        title: "Apakah Anda yakin?",
                text: "Apakah Anda yakin untuk menghapus data ini.",
                icon: "warning",
                buttons: true,
                dangerMode: true,
        })
        .then((willSave) => {
            if (willSave) {                
                var url = appBaseUrl + "/penugasan/delete_berkas";
                var param = {            
                    idpenugasantahapanberkas : id
                };
                $("body").loading('start');
                var req = $.post(url, param).done(function (data) {
                    if (data) {
                        if (data.status) {
                            swal("Data berhasil dihapus.", { 
                                            icon: "success",
                                            });            
                            //filter_berkas(i);
                            filter_berkas_tahapan(i, id);
                        }
                    }
                })
                    .always(function() {
                        $("body").loading('stop');
                    });
            } else {
                swal("Batal", "Proses Dibatalkan!", "info");
            }
        });                        
    };
    
    delete_tim = function(id) {
        
        swal({
        title: "Apakah Anda yakin?",
                text: "Apakah Anda yakin untuk menghapus data ini.",
                icon: "warning",
                buttons: true,
                dangerMode: true,
        })
        .then((willSave) => {
            if (willSave) {                
                var url = appBaseUrl + "/penugasan/delete_pegawai";
                var param = {            
                    idpenugasanpegawai : atob(id)
                };
                $("body").loading('start');
                var req = $.post(url, param).done(function (data) {
                    if (data) {
                        if (data.status) {
                            swal("Data berhasil dihapus.", { 
                                            icon: "success",
                                            });            
                            filter_tim($('#frm-pengguna [name=idpenugasan]').val());
                        }
                    }
                })
                    .always(function() {
                        $("body").loading('stop');
                    });
            } else {
                swal("Batal", "Proses Dibatalkan!", "info");
            }
        });                        
    };
    
    show_comment = function (id) {
        $('#div-preview').hide();
        $('.div-logbook').hide();
        $('.div-comment').show();        
        $('#frm-komentar [name=idpenugasantahapanberkas]').val(id);
        find_komentar(id);
    }
    
    lacak_logbook = function(t){
        if (!t) return;        
        $('.div-aktifitas').html("");
        var url = appBaseUrl + "/logbook/find_all";
        var param = {
            idpenugasantahapanberkas : t            
        };
        var req = $.post(url, param).done(function (data) {
            var tag = '<table id="tb-aktifitas" class="table table-hover table-bordered" width="100%"><thead><tr><th>Log</th></tr></thead><tbody>';
            //var tag = '<table id="tb-aktifitas" class="table table-hover table-condensed" width="100%"><thead></thead><tbody>';
            if (data && data.length > 0) {                
                    $.each(data, function(i, obj) {     
                        if (!obj.lokasi) obj.lokasi = '';
                        if (!obj.jam_mulai) obj.jam_mulai = '';
                        if (!obj.jam_selesai) obj.jam_selesai = '';
                        if (!obj.idstatus) obj.idstatus = '';
                        //<td><button class="btn btn-sm btn-danger btn-delete" onclick="log_delete(\''+btoa(obj.idlogbook)+'\',\''+t+'\')"  data-toggle="tooltip" data-placement="auto" title="Hapus"><i class="fa fa-trash"></i></button></td>
                        tag +='<tr><td>'+obj.aktifitas+' - '+obj.lokasi+'<br><small><i>'+ obj.username +': '+ obj.tanggal + ' '+ obj.jam_mulai +' - '+ obj.jam_selesai 
                                +'</i></small></td></tr>'; 
                    });                               
            } else {
                tag += '<tr><td colspan="3" align="center"><i>Data tidak tersedia.</i></td></tr>';
            }
            tag +='</tbody></table>';
            $('#div-aktifitas').html(tag);
            //order: [[0, "asc"]]     
            var table = $('#tb-aktifitas').DataTable({
                        dom: 'lBfrtip',
                        buttons: [                        
                            'excel'
                        ],
                        scrollX: true,
                        searching: true,
                        lengthMenu: [10, 25, 50, 75, 100]
                                           
                    });
                    
        })
        .always(function() {            
        });        
    };
    
    add_logbook = function(id, i, t) {
        
        $('#div-preview').hide();
        $('.div-comment').hide();
        
        $('.div-logbook').show();
        $("#frm-log")[0].reset();
        $("#frm-log [name=idlogbook]").val("");                            
        $("#frm-log [name=idpenugasan]").val(id);                            
        $("#frm-log [name=idpenugasantahapanberkas]").val(i);                            
        $("#frm-log [name=idtahapan]").val(t);     
        
        lacak_logbook(i);
        
        /**
        $("#frm-log")[0].reset();
        $("#frm-log [name=idlogbook]").val("");                            
        $("#frm-log [name=idpenugasan]").val(id);                            
        $("#frm-log [name=idpenugasantahapanberkas]").val(i);                            
        $("#frm-log [name=idtahapan]").val(t);     
        $("#modal-log").modal('show');
        */
    }
    
    $('.btn-reset-log').click(function () {
        $("#frm-log")[0].reset();
        $("#frm-log [name=idlogbook]").val("");                            
        $("#modal-log").modal('hide');
    });
    
    $('.btn-save-log').click(function () {
        var options = {
            target: '',
            success: function (result) {
                $(".btn-save-log").removeAttr("disabled");
                $("body").loading('stop');
                try {                    
                    var data = result;
                    if (data.status) {                
                        $('#modal-log').modal('hide');                        
                        swal(data.message, { 
                                            icon: "success"
                                            });     
                                            
                        if (data.data) { 
                            filter_berkas_tahapan($("#frm-log [name=idpenugasan]").val(), $("#frm-log [name=idtahapan]").val());
                            //filter_kegiatan();
                            //lacak(currentDate);
                            //filter_tim($('#frm-dokumen [name=idpenugasan]').val());                            
                        }
                        
                        return;                        
                    } else {                                                                    
                        swal(data.message, { 
                                            icon: "error"
                                            });    
                    }
                } catch (err) {
                    $.notify({title: "Information", message: err.message}, {type: "error", delay: 3});
                }                               
            }
        };              
        $("body").loading('start');        
        $(".btn-save-log").attr("disabled", true);
        $('#frm-log').ajaxForm(options).submit(); 
    });
    
    ajukan_verif = function(i, id) {
        
        swal({
        title: "Apakah Anda yakin?",
                text: "Apakah Anda yakin untuk mengajukan verifikasi berkas ini.",
                icon: "warning",
                buttons: true,
                dangerMode: true,
        })
        .then((willSave) => {
            if (willSave) {                
                var url = appBaseUrl + "/penugasan/set_verifikasi";
                var param = {            
                    idpenugasan : i,
                    idpenugasantahapanberkas: id
                };
                $("body").loading('start');
                var req = $.post(url, param).done(function (data) {
                    if (data) {
                        if (data.status) {
                            swal("Data berhasil diproses.", { 
                                            icon: "success",
                                            });            
                            filter_berkas(i);          
                            //filter_berkas_tahapan(i, id);
                        
                        }
                    }
                    var dtHtml = $('#tmp-data-aktifitas').html();
                    if (dtHtml) {
                        var pt = JSON.parse(dtHtml);
                        filter_berkas_tahapan(pt.idpenugasan, pt.idtahapan);
                    }
                })
                    .always(function() {
                        $("body").loading('stop');
                    });
            } else {
                swal("Batal", "Proses Dibatalkan!", "info");
            }
        });                        
    };
    
    reset_verif = function(i, id) {
        
        swal({
        title: "Apakah Anda yakin?",
                text: "Apakah Anda yakin untuk mengajukan membatalkan verifikasi berkas ini.",
                icon: "warning",
                buttons: true,
                dangerMode: true,
        })
        .then((willSave) => {
            if (willSave) {                
                var url = appBaseUrl + "/penugasan/reset_verifikasi";
                var param = {            
                    idpenugasan : i,
                    idpenugasantahapanberkas: id
                };
                $("body").loading('start');
                var req = $.post(url, param).done(function (data) {
                    if (data) {
                        if (data.status) {
                            swal("Data berhasil diproses.", { 
                                            icon: "success",
                                            });            
                            filter_berkas(i);        
                            //filter_berkas($('#frm-berkas [name=idpenugasan]').val());
                            //filter_berkas_tahapan(i, id);
                        }
                    }
                    var dtHtml = $('#tmp-data-aktifitas').html();
                    if (dtHtml) {
                        var pt = JSON.parse(dtHtml);
                        filter_berkas_tahapan(pt.idpenugasan, pt.idtahapan);
                    }
                })
                    .always(function() {
                        $("body").loading('stop');
                    });
            } else {
                swal("Batal", "Proses Dibatalkan!", "info");
            }
        });                        
    };
  
    filter_berkas = function(id){      
        combo_penugasan_tahapan(id, $('#frm-berkas [name=idjenispenugasan]').val());
        var url = appBaseUrl + "/penugasan/find_berkas";
        var param = {
            idpenugasan : id            
        };
        $('.div-berkas-1').html("");
        $('.div-berkas-2').html("");
        $('.div-berkas-3').html("");
        $('.div-berkas-4').html("");
        $('.div-berkas-5').html("");
        $('.div-berkas-6').html("");
        $('.div-berkas-7').html("");
        $('.div-berkas-8').html("");
        $('.div-berkas-9').html("");
        $('.div-berkas-10').html("");
        $('.div-berkas-11').html("");
        var req = $.post(url, param).done(function (data) {                        
            var no = 0;      
            var t ='';
            var d = '';
            var dobj = null;
            if (data) {                            
                    var content='';           
                    var tahapan = '';
                    var idtahapan= '';
                    
                    var tahapanprev = '';
                    var idtahapanprev= '';
                    var dprev = null;
                    var selesaiprev = null;
                    
                    $.each(data, function(i, obj) {
                        d = JSON.stringify(obj);
                        dobj = obj;
                        var h = "<input type='hidden' value='" + d + "'/>";                                                                                                                                                            
                        if (tahapan != obj.tahapan) {                                                        
                            //Tampilkan 
                            if (tahapan) {                                                                
                                var thead = '<table class="table table-condensed table-hover" width="100%" id="tb-berkas-'+ idtahapan +'">'+
                                        '<thead><tr><th>Tahapan</th><th>Aktifitas</th><th>Berkas</th><th>Status</th><th>Aksi</th></tr>\n\
</thead><tbody>';                                                        
                                t += '</tbody> </table>';            
                                tableTag = thead + t;
                                
                                var box = '<div class="box box-default collapsed-box"> <div class="box-header with-border"> <h3 class="box-title">'+ idtahapan+'. '+ tahapan +'</h3> <div class="box-tools pull-right"> <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-plus"></i></button> </div> </div> <div class="box-body" style="">\n\
                                <div class="div-table-'+idtahapan+'">'+ tableTag +'</div> </div></div>';
                                
                                $('.div-berkas-' + idtahapan).html(box);
                                var groupColumn = 0;   
                                
                                var ck = '';
                                if (selesaiprev) {
                                    ck = ' checked="checked" ';
                                }
                        
                                var checkSlider = '<div class="pull-right block-log-verif div-save"><label class="pull-left"> <input type="checkbox" value="'+btoa(dprev)+'" '+ ck +'  onchange="handleCheckSlider(this)" class="switch-service switch switch-blue"><span></span></label></div>';            
                                var table = $('#tb-berkas-'+ idtahapan).DataTable({
                                        dom: 'lBfrtip',
                                        buttons: [                        
                                            'excel'
                                        ],
                                        scrollX: false,
                                        searching: true,
                                        lengthMenu: [10, 25, 50, 75, 100],
                                        columnDefs: [{ visible: false, targets: groupColumn }],     
                                        order: [[0, "asc"]],
                                        drawCallback: function (settings) {
                                            var api = this.api();
                                            var rows = api.rows({ page: 'current' }).nodes();
                                            var last = null;
                                            api
                                                .column(groupColumn, { page: 'current' })
                                                .data()
                                                .each(function (group, i) {
                                                    if (last !== group) {
                                                        $(rows)
                                                            .eq(i)
                                                            .before('<tr class="group"><td colspan="3">' + group + '</td><td>'+ checkSlider +'</td></tr>');

                                                        last = group;
                                                    }
                                                });
                                        },
                                    });

                                $('#tb-berkas-'+ idtahapan +' tbody').on('click', 'tr', function () {
                                            var d = $(this).find('input[type="hidden"]').val();
                                            if (d) {
                                                if ($(this).hasClass('selected')) {
                                                    $(this).removeClass('selected');                                
                                                } else {
                                                    table.$('tr.selected').removeClass('selected');
                                                    $(this).addClass('selected'); 
                                                    $('#tmp-data-aktifitas').html(d);
                                                }
                                            }
                                        });   
                                
                                t = '';
                            }
                            no = 0;      
                            tahapan = obj.tahapan;       
                            idtahapan = obj.idtahapan;
                            dprev = JSON.stringify(obj);
                            selesaiprev = obj.tglselesai;
                        }
                        no++;            
                        var btnTautan = '';
                        if (obj.linkberkas) {
                            btnTautan += '<button class="btn btn-sm btn-default" onclick="preview_berkas(\''+btoa(obj.linkberkas)+'\')"><i class="fa fa-link"></i></button>';
                        }
                        if (obj.pathberkas) {
                            btnTautan += '<button class="btn btn-sm btn-default" onclick="unduh_berkas(\''+btoa(obj.pathberkas)+'\')"><i class="fa fa-file-archive"></i></button>';
                        }
                        var btnAksi = '';
                        btnAksi += '<button class="btn btn-sm btn-danger" title="Hapus Aktifitas" onclick="delete_berkas(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-trash"></i></button>';
                        btnAksi += '<button class="btn btn-sm btn-warning" title="Ubah Aktifitas" onclick="edit_berkas(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-pencil-square"></i></button>';
                        
                        var btnLacak = '<button class="btn btn-sm btn-default" title="Lacak Verifikasi" onclick="lacak_verif_berkas(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-binoculars"></i> ('+obj.totalverifikator+'/'+obj.totalverifikatordone+')</button>';
                        
                        var btnComment = '<button class="btn btn-sm btn-primary" title="Komentar" onclick="show_comment(\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-comments-o"></i>('+obj.totalkomentar+')</button>';
                        //var btnLogBook = '<button class="btn btn-sm btn-primary" title="Log Book" onclick="add_logbook(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\',\''+obj.idtahapan+'\')"><i class="fa fa-book"></i>('+obj.totallogbook+')</button>';
                        if (!obj.tag) obj.tag = '';
                        var btnVerif = '';
                        if (obj.totalverifikator <= 0) {
                            btnVerif = '<button class="btn btn-sm btn-primary" title="Ajukan Verifikasi" onclick="ajukan_verif(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-send"></i></button>';
                        } else {
                            btnVerif = '<button class="btn btn-sm btn-danger" title="Batal Verifikasi" onclick="reset_verif(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-times-circle"></i></button>';
                        }
                        btnTautan = '<button class="btn btn-sm btn-default " onclick="dok_versi(\''+obj.idpenugasantahapanberkas+'\')"  data-toggle="tooltip" data-placement="auto" title="Daftar Versi Berkas"><i class="fa fa-copy"></i>('+obj.totalberkas+')</button>';
                        btnTautan += '<button class="btn btn-sm btn-primary " onclick="dok_versi_tambah(\''+obj.idpenugasantahapanberkas+'\')"  data-toggle="tooltip" data-placement="auto" title="Tambah Versi Berkas"><i class="fa fa-plus-circle"></i></button>';
                        var ts = obj.waktu_kirim;
                        if (!ts) ts = obj.timestamp;
                        var isfinal = '<span><i class="fa fa-lg fa-question-circle"></i></span>';
                        if (obj.isfinal == '1') {
                            isfinal = '<span class="text-green"><i class="fa fa-lg fa-check-circle"></i></span>';
                        } else if (obj.isfinal == '2') {
                            isfinal = '<span class="text-red"><i class="fa fa-lg fa-exclamation-circle"></i></span>';
                        }
                        
                        var content = '<tr>' +
                            '<td><span class="text-info">Deadline Tahapan: '+ conv_date_indo(obj.deadline) +'</span></td>' +
                            '<td>' + obj.judul + '<br/><small><i>'+obj.username+': '+ts+'</i></small></td>' + 
                            //'<td><b>' + obj.tag + h +'</b></td>' +                            
                            '<td>'+ btnTautan + h +'</td>' +
                            //'<td>' + btnLacak + btnVerif +'</td>' +
                            '<td>'+ isfinal +'</td>' +                            
                            '<td>'+ btnAksi + btnComment  +'</td></tr>';
                        t += content;
                    });                                    
            }        
            
            if (t) {                                
                var thead = '<table class="table table-bordered table-hover" width="100%" id="tb-berkas-'+ idtahapan +'">'+
                                        '<thead><tr><th >Tahapan</th><th >Aktifitas</th><th>Berkas</th><th>Status</th><th >Aksi</th></tr>\n\
</thead><tbody>'; 
                t += '</tbody> </table>';            
                tableTag = thead + t;

                var box = '<div class="box box-default collapsed-box"> <div class="box-header with-border"> <h3 class="box-title">'+ idtahapan+'. '+ tahapan +'</h3> <div class="box-tools pull-right"> <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-plus"></i></button> </div> </div> <div class="box-body" style="">\n\
                                <div class="div-table-'+idtahapan+'">'+ tableTag +'</div> </div></div>';

                $('.div-berkas-' + idtahapan).html(box);
                var groupColumn = 0;       
                
                var ck = '';
                if (dobj.tglselesai) {
                    ck = ' checked="checked" ';
                }
                
                var checkSlider = '<div class="pull-right block-log-verif div-save"><label class="pull-left"> <input type="checkbox" value="'+btoa(d)+'" '+ ck +'  onchange="handleCheckSlider(this)" class="switch-service switch switch-blue"><span></span></label></div>';            
                var table = $('#tb-berkas-'+ idtahapan).DataTable({
                        dom: 'lBfrtip',
                        buttons: [                        
                            'excel'
                        ],
                        scrollX: false,
                        searching: true,
                        lengthMenu: [10, 25, 50, 75, 100],
                        columnDefs: [{ visible: false, targets: groupColumn }],     
                        order: [[0, "asc"]],
                        drawCallback: function (settings) {
                            var api = this.api();
                            var rows = api.rows({ page: 'current' }).nodes();
                            var last = null;
                            api
                                .column(groupColumn, { page: 'current' })
                                .data()
                                .each(function (group, i) {
                                    if (last !== group) {
                                        $(rows)
                                            .eq(i)
                                            .before('<tr class="group"><td colspan="3">' + group + '</td><td>'+ checkSlider +'</td></tr>');

                                        last = group;
                                    }
                                });
                        },
                    });

                $('#tb-berkas-'+ idtahapan +' tbody').on('click', 'tr', function () {
                            var d = $(this).find('input[type="hidden"]').val();
                            if (d) {
                                if ($(this).hasClass('selected')) {
                                    $(this).removeClass('selected');                                
                                } else {
                                    table.$('tr.selected').removeClass('selected');
                                    $(this).addClass('selected');         
                                    $('#tmp-data-aktifitas').html(d);
                                }
                            }
                        });   

                t = '';
            }
                                
        })
        .always(function() {
            
        });
    };
    
    filter_berkas_tahapan = function(id, idtahapan){      
        combo_penugasan_tahapan(id, $('#frm-berkas [name=idjenispenugasan]').val());
        var url = appBaseUrl + "/penugasan/find_berkas";
        var param = {
            idpenugasan : id,
            idtahapan: idtahapan
        };
        $('.div-table-' + idtahapan).html("");
        var req = $.post(url, param).done(function (data) {
            
            var t = '';
            var no = 0;      
            if (data) {                            
                    var content='';           
                    var tahapan = '';
                    $.each(data, function(i, obj) {
                        var d = JSON.stringify(obj);
                        var h = "<input type='hidden' value='" + d + "'/>";                                                                                                                                                            
                        no++;            
                        var btnTautan = '';
                        if (obj.linkberkas) {
                            btnTautan += '<button class="btn btn-sm btn-default" onclick="preview_berkas(\''+btoa(obj.linkberkas)+'\')"><i class="fa fa-link"></i></button>';
                        }
                        if (obj.pathberkas) {
                            btnTautan += '<button class="btn btn-sm btn-default" onclick="unduh_berkas(\''+btoa(obj.pathberkas)+'\')"><i class="fa fa-file-archive"></i></button>';
                        }
                        var btnAksi = '';
                        btnAksi += '<button class="btn btn-sm btn-danger" title="Hapus Berkas" onclick="delete_berkas(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-trash"></i></button>';
                        btnAksi += '<button class="btn btn-sm btn-warning" title="Ubah Berkas" onclick="edit_berkas(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-pencil-square"></i></button>';
                        
                        var btnLacak = '<button class="btn btn-sm btn-default" onclick="lacak_verif_berkas(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-binoculars"></i> ('+obj.totalverifikator+'/'+obj.totalverifikatordone+')</button>';
                        
                        var btnComment = '<button class="btn btn-sm btn-primary" title="Komentar" onclick="show_comment(\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-comments-o"></i>('+obj.totalkomentar+')</button>';
                        //var btnLogBook = '<button class="btn btn-sm btn-primary" title="Log Book" onclick="add_logbook(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\',\''+obj.idtahapan+'\')"><i class="fa fa-book"></i>('+obj.totallogbook+')</button>';
                        
                        if (!obj.tag) obj.tag = '';
                        var btnVerif = '';
                        if (obj.totalverifikator <= 0) {
                            btnVerif = '<button class="btn btn-sm btn-primary" title="Ajukan Verifikasi" onclick="ajukan_verif(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-send"></i></button>';
                        } else {
                            btnVerif = '<button class="btn btn-sm btn-danger"  title="Batal Verifikasi" onclick="reset_verif(\''+obj.idpenugasan+'\',\''+obj.idpenugasantahapanberkas+'\')"><i class="fa fa-times-circle"></i></button>';
                        }
                        btnTautan = '<button class="btn btn-sm btn-default " onclick="dok_versi(\''+obj.idpenugasantahapanberkas+'\')"  data-toggle="tooltip" data-placement="auto" title="Daftar Versi Berkas"><i class="fa fa-copy"></i>('+obj.totalberkas+')</button>';
                        btnTautan += '<button class="btn btn-sm btn-primary " onclick="dok_versi_tambah(\''+obj.idpenugasantahapanberkas+'\')"  data-toggle="tooltip" data-placement="auto" title="Tambah Versi Berkas"><i class="fa fa-plus-circle"></i></button>';
                        
                        var ts = obj.waktu_kirim;
                        if (!ts) ts = obj.timestamp;
                        var isfinal = '<span><i class="fa fa-lg fa-question-circle"></i></span>';
                        if (obj.isfinal == '1') {
                            isfinal = '<span class="text-green"><i class="fa fa-lg fa-check-circle"></i></span>';
                        } else if (obj.isfinal == '2') {
                            isfinal = '<span class="text-red"><i class="fa fa-lg fa-exclamation-circle"></i></span>';
                        }
                        var content = '<tr>' +
                            '<td><span class="text-info">Deadline Tahapan: '+ conv_date_indo(obj.deadline) +'</span></td>' +
                            '<td>' + obj.judul + '<br/><small><i>'+obj.username+': '+ts+'</i></small></td>' +                                                
                            '<td>'+ btnTautan + h +'</td>' +
                            //'<td>' + btnLacak + btnVerif + '</td>' +
                            '<td>'+ isfinal+'</td>' +
                            '<td>'+ btnAksi + btnComment  + '</td></tr>';
                        t += content;
                        
                    });
                                  

            }           
                
            var thead = '<table class="table table-condensed table-hover" width="100%" id="tb-berkas-'+ idtahapan +'">'+
                                        '<thead><tr><th>Tahapan</th><th>Aktifitas</th><th>Berkas</th><th>Status</th><th >Aksi</th></tr>\n\
</thead><tbody>'; 
                t += '</tbody> </table>';            
                tableTag = thead + t;
            //$('.div-berkas').html(t);
            $('.div-table-' + idtahapan).html(tableTag);
            
            var groupColumn = 0;
            //order: [[groupColumn, 'asc']],              
            var checkSlider = '<div class="pull-right block-log-verif div-save"><label class="pull-left"> <input type="checkbox" value=""  onchange="handleCheckSlider(this)" class="switch-service switch switch-blue"><span></span></label></div>';            
            var table = $('#tb-berkas-'+ idtahapan ).DataTable({
                    dom: 'lBfrtip',
                    buttons: [                        
                        'excel'
                    ],
                    scrollX: false,
                    searching: true,
                    lengthMenu: [10, 25, 50, 75, 100],
                    columnDefs: [{ visible: false, targets: groupColumn }],     
                    order: [[0, "asc"]],
                    drawCallback: function (settings) {
                        var api = this.api();
                        var rows = api.rows({ page: 'current' }).nodes();
                        var last = null;
                        api
                            .column(groupColumn, { page: 'current' })
                            .data()
                            .each(function (group, i) {
                                if (last !== group) {
                                    $(rows)
                                        .eq(i)
                                        .before('<tr class="group"><td colspan="3">' + group + '</td><td>'+ checkSlider +'</td></tr>');

                                    last = group;
                                }
                            });
                    },
                });
                
            $('#tb-berkas-'+ idtahapan+' tbody').on('click', 'tr', function () {
                        var d = $(this).find('input[type="hidden"]').val();
                        if (d) {
                            if ($(this).hasClass('selected')) {
                                $(this).removeClass('selected');                                
                            } else {
                                table.$('tr.selected').removeClass('selected');
                                $(this).addClass('selected');   
                                $('#tmp-data-aktifitas').html(d);
                            }
                        }
                    });                       
        })
        .always(function() {
            
        });
    };
    
    conv_date_indo = function (dateString){
        if (!dateString) return 'Belum diset.';
        try {
            var date = new Date(dateString);//Date.parse(dateString);
            var tahun = date.getFullYear();
            var bulan = date.getMonth();
            var tanggal = date.getDate();
            var hari = date.getDay();
            /**
            var jam = date.getHours();
            var menit = date.getMinutes();
            var detik = date.getSeconds();
            */
            switch(hari) {
             case 0: hari = "Minggu"; break;
             case 1: hari = "Senin"; break;
             case 2: hari = "Selasa"; break;
             case 3: hari = "Rabu"; break;
             case 4: hari = "Kamis"; break;
             case 5: hari = "Jum'at"; break;
             case 6: hari = "Sabtu"; break;
            }
            switch(bulan) {
             case 0: bulan = "Januari"; break;
             case 1: bulan = "Februari"; break;
             case 2: bulan = "Maret"; break;
             case 3: bulan = "April"; break;
             case 4: bulan = "Mei"; break;
             case 5: bulan = "Juni"; break;
             case 6: bulan = "Juli"; break;
             case 7: bulan = "Agustus"; break;
             case 8: bulan = "September"; break;
             case 9: bulan = "Oktober"; break;
             case 10: bulan = "November"; break;
             case 11: bulan = "Desember"; break;
            }
            return hari + ", " + tanggal + " " + bulan + " " + tahun;
        } catch(err){
            console.log(err.message);
        }
    };
    
    combo_penugasan_tahapan = function(id, ij){        
