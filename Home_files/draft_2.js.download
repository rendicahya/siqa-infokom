                            content = '<option value="'+obj.idtahapan+'">'+obj.tahapan+'</option>';                        
                            $('#frm-berkas [name=idtahapan]').append(content);
                        }
                    });                    
            }            
            
        })
        .always(function() {
            
        });
    };
    
