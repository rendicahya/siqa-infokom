    filter_tahapan = function(id, ij){        
        var url = appBaseUrl + "/penugasan/find_tahapan";
        var param = {
            idpenugasan : id,
            idjenispenugasan: ij
        };
        $('.div-atur').html("");
        var req = $.get(url, param).done(function (data) {
            
            var t = '<table class="table table-condensed table-hover" width="100%" id="tb-personil"><thead><tr><th>No</th><th>Tahapan</th><th>Deadline</th><th>Realisasi</th><th>Aktivasi</th></tr></thead>'+
                '<tbody>';                        
            var no = 0;      
            if (data && data.length > 0) {
                    var content='';
                    //t+= '<tr><td colspan="5"><span class="text-info">'+ lblperan[j] +'</span></td></tr>';
                    $.each(data, function(i, obj) {
                        var d = btoa(JSON.stringify(obj));
                        //var h = "<input type='hidden' value='" + d + "'/>";
                        var ck = '';
                        if (obj.idpenugasan) {
                            ck = ' checked="checked" ';
                        }
                        if (!obj.deadline) obj.deadline = '';
                            if (!obj.tglselesai) obj.tglselesai = '';
                            content += '<tr>' +
                                '<td align="center">' + obj.urut + '</td>' +
                                '<td><b>' + obj.tahapan +  '</b></td>' +
                                '<td><input type="date" class="form-control" value="'+obj.deadline+'" name="inp_deadline" onchange="handleCheckDeadline(this,\''+d+'\')" /></td>' +
                                '<td align="center">' + obj.tglselesai + '</td>' +
                                '<td><div class="pull-right block-log-verif div-save"><label class="pull-left"> <input type="checkbox" value="'+d+'" '+ ck +' onchange="handleCheck(this)" class="switch-service switch switch-blue"><span></span></label></div></td></tr>';
                        
                    });
                    t += content;

            }
            //$('.div-atur').html(no);
            t += '</tbody> </table>';
            //<button class="btn btn-sm btn-primary btn-ref" onclick="dok_referensi('+obj.id_dokumen+')"><i class="fa fa-navicon"></i>&nbsp; Dok. Referensi</button>&nbsp;
            $('.div-atur').html(t);
        })
        .always(function() {
            
        });
    };
    
    load_data = function(obj) {
        //var dt = $('#data-detail').html();
        if (obj) {                    
            $('.tugas-detail').show();
            $('.block-info').show();
            //var obj = JSON.parse(dt);
            var proposal = '', doc='', final='';
            //$('.div-proposal').html(proposal);
            //$('.div-doc').html(doc);
            if (obj) {
                $('.judul').html(obj.judul);
                $('.deskripsi').html(obj.deskripsi);
                
                for( var key in obj ) {
                    var value = obj[key];
                    if (key == 'idpenugasan')
                        $('[name='+key+']').val(value);
                    else if (key == 'lampiranst') { 
                        $('.link-st').html("");
                        if (value) {
                            var url = baseUrl + '/' + value;
                            var link = '<a href="'+url+'" class="btn btn-primary"><i class="fa fa-paperclip"></i> Preview</a>';
                            $('.link-st').html(link);
                        }
                    } else $('#frm-dokumen [name='+key+']').val(value);                               
                    if (key == 'tglmulai' || key == 'tglselesai')  {
                        if (value) {
                            value = conv_date_indo(value);
                        }
                    } 
                    
                    if (key == 'idauditee' && value) {
                        var dt = {
                            id: obj.idauditee,
                            text: obj.auditee
                        };
                        var newOption = new Option(dt.text, dt.id, false, false);
                        $('#frm-dokumen [name=idauditee]').append(newOption).trigger('change');                        
                    } else if (key == 'idunitpenugasan' && value) {
                        var dt = {
                            id: obj.idunitpenugasan,
                            text: obj.unitpenugasan
                        };
                        var newOption = new Option(dt.text, dt.id, false, false);
                        $('#frm-dokumen [name=idunitpenugasan]').append(newOption).trigger('change'); 
                    } 
                    
                    /**
                    if (key == 'anggaran') {
                        value = currency(value, { symbol : 'Rp ', separator: ',', precision:2 }).format();
                    }
                    if (key == 'reward') {
                        value = (value == 'remun') ? 'Remunerasi' : 'Non Remunerasi';
                    }
                    if (key == 'lampiran') {
                        if (value) {
                            value = baseUrl + '/' + value;
                            console.log(value);
                            proposal += '<button class="btn btn-primary" onclick="preview_pdf(\''+value+'\')" title="File Proposal" role="button"><i class="fa fa-paperclip"></i></button>';
                        }
                    } else if (key == 'tautan') {
                        if (value) {                            
                            console.log(value);
                            proposal += '<button class="btn btn-primary" onclick="preview_pdf(\''+value+'\')" title="Tautan Proposal" role="button"><i class="fa fa-link"></i></button>';
                        }
                    } else {                    
                        $('.lbl-'+key+'').html(value); 
                    }

                    if (key == 'lampiranfinal') {
                        if (value) {
                            value = baseUrl + '/' + value;
                            final += '<button class="btn btn-primary" onclick="preview_pdf(\''+value+'\')" title="File Proposal" role="button"><i class="fa fa-paperclip"></i></button>';
                        }
                    } else if (key == 'tautanfinal') {
                        if (value) {
                            final += '<button class="btn btn-primary" onclick="preview_pdf(\'' + value + '\')" title="Tautan Proposal" role="button"><i class="fa fa-link"></i></button>';
                        }
                    }
                    */
                }
                
                filter_tim(obj.idpenugasan);
                filter_tahapan(obj.idpenugasan, obj.idjenispenugasan);
                filter_berkas(obj.idpenugasan);
                
                $('#frm-berkas [name=idjenispenugasan]').val(obj.idjenispenugasan);
                
            }                       
        }
    };
    
