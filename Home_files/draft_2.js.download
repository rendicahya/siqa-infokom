    $('.btn-save-pengguna').click(function () {
        var options = {
            target: '',
            success: function (result) {
                $(".btn-save-pengguna").removeAttr("disabled");
                $("body").loading('stop');
                try {                    
                    var data = result;
                    if (data.status) {                
                        $('#modal-pengguna').modal('hide');                        
                        swal(data.message, { 
                                            icon: "success",
                                            });     
                                            
                        if (data.data) {   
                            filter_tim($('#frm-pengguna [name=idpenugasan]').val());                            
                        }
                        return;                        
                    } else {                                                                    
                        swal(data.message, { 
                                            icon: "error",
                                            });    
                    }
                } catch (err) {
                    $.notify({title: "Information", message: err.message}, {type: "error", delay: 3});
                }                               
            }
        };      
        
        $("body").loading('start');
        
        $(".btn-save-pengguna").attr("disabled", true);
        $('#frm-pengguna').ajaxForm(options).submit();                
        
    });
                        
    $('.btn-save-penugasan').click(function () {
        var options = {
            target: '',
            success: function (result) {
                $(".btn-save-penugasan").removeAttr("disabled");
